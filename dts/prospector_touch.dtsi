/*
 * Touch on the Prospector dongle's screen (src/dongle_screen_fx.c).
 *
 * The Waveshare 1.69" touch panel has a CST816 touch controller on four
 * wires that the Prospector assembly manual says to cut. Connected to the
 * XIAO like this, it works:
 *
 *   TP_SDA -> D4 (SDA)    TP_SCL -> D5 (SCL)
 *   TP_IRQ -> D2          TP_RST -> D1
 *
 * D2, D4 and D5 are where the optional light sensor goes, so this is for a
 * dongle without one (the two can share D4/D5, but not D2).
 *
 * Harmless when the wires aren't connected: the controller isn't found at
 * start-up and nothing else changes.
 */

#include <dt-bindings/gpio/gpio.h>

/* the XIAO's own pull-ups, in case the panel's board has none on these lines */
&i2c1_default {
    group1 {
        bias-pull-up;
    };
};

&i2c1 {
    status = "okay";

    prospector_touch: cst816s@15 {
        compatible = "hynitron,cst816s";
        reg = <0x15>;
        irq-gpios = <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        rst-gpios = <&xiao_d 1 GPIO_ACTIVE_LOW>;
    };
};
