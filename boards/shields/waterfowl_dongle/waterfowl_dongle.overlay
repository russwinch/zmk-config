/*
 * Waterfowl dongle (e.g. Prospector on a XIAO nRF52840).
 *
 * No keys of its own: a mock kscan stands in, and the matrix transform and
 * sensor list mirror ZMK's waterfowl.dtsi so key positions and encoder
 * indices reported by the halves line up with the shared keymap.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    /*
     * Placeholder encoders, disabled: the real ones live on the halves.
     * Only their order in &sensors matters (same as waterfowl.dtsi).
     * The GPIOs are never configured.
     */
    roller_left_encoder: encoder_left_roller {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };
    dial_left_encoder: encoder_left_dial {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };
    dial_right_encoder: encoder_right_dial {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };
    roller_right_encoder: encoder_right_roller {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        triggers-per-rotation = <20>;
        sensors = <
            &roller_left_encoder
            &dial_left_encoder
            &dial_right_encoder
            &roller_right_encoder
        >;
    };
};

/* touch on the Prospector's screen, if its four wires are connected */
#include <prospector_touch.dtsi>
