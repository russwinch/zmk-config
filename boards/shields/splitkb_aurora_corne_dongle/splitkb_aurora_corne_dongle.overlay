/*
 * splitkb Aurora Corne dongle (e.g. Prospector on a XIAO nRF52840).
 *
 * No keys of its own: a mock kscan stands in, and the matrix transform and
 * sensor list mirror ZMK's splitkb_aurora_corne.dtsi (its 6-column transform,
 * the one the keymap uses) so key positions and encoder indices reported by
 * the halves line up with the shared keymap.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    /*
     * Placeholder encoders, disabled: the real ones live on the halves.
     * Only their order in &sensors matters (same as splitkb_aurora_corne.dtsi).
     * The GPIOs are never configured.
     */
    left_encoder: left_encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };
    right_encoder: right_encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};

/* touch on the Prospector's screen, if its four wires are connected */
#include <prospector_touch.dtsi>
